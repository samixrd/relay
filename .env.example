# RELAY — NEAR Testnet only.
# Copy to .env. This file is read by the local server; it is never served to the browser.
# Never commit real keys. Never expose secrets in client-side code or logs.

# --- NEAR Testnet -----------------------------------------------------------
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_EXPLORER_BASE_URL=https://testnet.nearblocks.io
NEAR_SIGNER_CONTRACT_ID=v1.signer-prod.testnet

# Deployed RELAY NFT contract (Testnet).
RELAY_CONTRACT_ID=relay.spellman.testnet
# Local controller WASM used by deployment tooling.
RELAY_CONTROLLER_WASM_PATH=target/wasm32-unknown-unknown/release/relay_subaccount.wasm
# Account label for deployment tooling only.
NEAR_ACCOUNT_ID=

# --- Google sign-in through official NEAR Auth / FastAuth --------------------
# The browser connects to Auth0 and derives an MPC Ed25519 signing key on v1.signer-prod.testnet.
# Defaults to the official NEAR Foundation FastAuth tenant (login.testnet.fast-auth.com).
# For a custom Auth0 tenant or dedicated hackathon domain:
# NEAR_AUTH_DOMAIN=dev-6lnxwka7c4hvpiou.us.auth0.com
# NEAR_AUTH_CLIENT_ID=dDsdq8rK4mOOGPiLTqVN9V9gn6cdanJL
# NEAR_AUTH_CLIENT_SECRET=
# NEAR_AUTH_SIGNING_AUDIENCE=dDsdq8rK4mOOGPiLTqVN9V9gn6cdanJL
# Optional overrides (defaults shown):
# NEAR_AUTH_MPC_CONTRACT_ID=v1.signer-prod.testnet
# NEAR_AUTH_FAST_AUTH_CONTRACT_ID=fast-auth.testnet

# --- Server-side sponsor ----------------------------------------------------
# A FullAccess Testnet key used only to create sponsored user accounts, top up
# gas within a budget, and pay the FastAuth signing deposit. The sponsor never
# signs a user's transaction. Fallback order:
#   NEAR_AUTH_SPONSOR_PRIVATE_KEY -> OWNER_B_PRIVATE_KEY -> NEAR_PRIVATE_KEY
NEAR_AUTH_SPONSOR_PRIVATE_KEY=
# Optional sponsor account override (defaults to the key's implicit account).
# NEAR_AUTH_SPONSOR_ACCOUNT_ID=relay.spellman.testnet

# Gas sponsorship budget. Defaults: 5 NEAR/hour and 3 NEAR/account.
# NEAR_AUTH_HOURLY_BUDGET_YOCTO=5000000000000000000000000
# NEAR_AUTH_ACCOUNT_BUDGET_YOCTO=3000000000000000000000000

# --- Supported NEP-141 assets ----------------------------------------------
# Comma-separated list of supported Testnet NEP-141 contracts. Defaults to wrap.testnet (wNEAR).
# NEAR_AUTH_FT_ASSETS=wrap.testnet,aapl.spellman.testnet,tsla.spellman.testnet,gold.spellman.testnet,oil.spellman.testnet

# --- Demo Stock & Commodity Faucet (Optional) -------------------------------
# The treasury account and key used to fund demo NEP-141 grants to card accounts.
# Defaults to NEAR_ACCOUNT_ID and NEAR_PRIVATE_KEY if unset.
# STOCK_FAUCET_ACCOUNT_ID=
# STOCK_FAUCET_PRIVATE_KEY=

# --- Artwork storage --------------------------------------------------------
# local (default): durable files under data/uploads on this host. Not permanent
#   public storage; suitable for local Testnet development only.
# http: raw PUT to an object-storage endpoint that returns a public HTTPS URL.
# ipfs: pin through an IPFS pinning HTTP endpoint and serve from a gateway.
# s3 and object are accepted aliases for http. If a non-local provider is
# selected without its settings, uploads fail with STORAGE_UNAVAILABLE.
UPLOAD_STORAGE_PROVIDER=local
# UPLOAD_HTTP_ENDPOINT=https://object-storage.example.com/relay-art
# UPLOAD_HTTP_TOKEN=
# UPLOAD_HTTP_PUBLIC_BASE=https://cdn.example.com/relay-art
# UPLOAD_IPFS_PINNING_URL=https://api.pinata.cloud/pinning/pinFileToIPFS
# UPLOAD_IPFS_TOKEN=
# UPLOAD_IPFS_GATEWAY=https://ipfs.io/ipfs

# --- App --------------------------------------------------------------------
APP_PORT=3000
# Public HTTPS URL used for shareable claim links and Secure cookies.
PUBLIC_APP_URL=

# Server-side secret for HMAC-signed session cookies and email-bound claims.
# At least 16 characters in production. Strictly confidential.
CLAIM_SESSION_SECRET=

# Optional custom path for the durable claim journal.
# CLAIM_JOURNAL_PATH=data/claim-sessions.journal
